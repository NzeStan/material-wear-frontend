# Copy to .env and fill in your values. Never commit .env.
# Client-side vars MUST be prefixed with VITE_ for Vite to expose them.

# ── APP CORE ──────────────────────────────────────────────────
VITE_APP_NAME=Material Wear Limited

# Unset = talks to the local Django dev server (http://localhost:8000/api).
# REQUIRED in production — production builds have no fallback.
# VITE_API_BASE_URL=https://api.your-domain.com/api

# Optional. Unset = Google login uses the server-side redirect flow.
# A fake value is worse than none — Google rejects invalid IDs.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── FEATURES ──────────────────────────────────────────────────
# Shows the light/dark toggle in the navbar.
VITE_ENABLE_DARK_MODE=true

# AdSense only loads once this is a real "ca-pub-" + digits value.
VITE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# ── BRAND INFO ────────────────────────────────────────────────
VITE_FOUNDED_YEAR=2020
# CAC registration number (RC number), shown in the footer and Terms & Conditions.
VITE_RC_NUMBER=9161164

# ── CONTACT INFORMATION ───────────────────────────────────────
# Shown publicly in the footer and Contact page.
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_PHONE=+234 000 000 0000
VITE_WHATSAPP_NUMBER=+2340000000000
VITE_ADDRESS=Street, City, State, Country

# ── SOCIAL MEDIA ──────────────────────────────────────────────
VITE_INSTAGRAM_URL=https://instagram.com/yourhandle
VITE_FACEBOOK_URL=https://facebook.com/yourhandle
VITE_TWITTER_URL=https://x.com/yourhandle
VITE_TIKTOK_URL=https://tiktok.com/@yourhandle
VITE_YOUTUBE_URL=https://youtube.com/@yourhandle
